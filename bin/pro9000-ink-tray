#!/usr/bin/env python3
"""Tray icon for the Canon Pro9000 Mk II: a mini ink gauge, tooltip with levels, a menu,
and desktop notifications when a tank goes LOW or EMPTY. Polls every 10 minutes when idle."""
import gi, json, os, subprocess, sys, time
gi.require_version("Gtk", "3.0"); gi.require_version("Notify", "0.7")
from gi.repository import Gtk, Gdk, GLib, GdkPixbuf, Notify
import cairo

def _sibling(name):
    here = os.path.join(os.path.dirname(os.path.abspath(__file__)), name)
    return here if os.path.exists(here) else os.path.expanduser("~/.local/bin/" + name)
READER = _sibling("pro9000-ink-read")
GUI    = _sibling("pro9000-ink-gui")
STATE  = os.path.expanduser("~/.cache/pro9000-ink-state.json")
POLL_MIN, RETRY_MIN = 10, 2
COLORS = {"PBK":(0.10,0.10,0.10),"C":(0.00,0.66,0.88),"M":(0.90,0.00,0.49),"Y":(1.00,0.83,0.00),
          "LC":(0.56,0.84,0.94),"LM":(0.95,0.60,0.78),"R":(0.88,0.19,0.12),"G":(0.23,0.67,0.21)}
STATUS_RGB = {"ok":(0.20,0.65,0.30),"low":(0.93,0.62,0.05),"empty":(0.85,0.15,0.10)}

def load():
    for cmd in ([READER, "--json"], ["sudo", "-n", READER, "--json"]):
        try:
            out = subprocess.run(cmd, capture_output=True, text=True, timeout=20).stdout.strip(); d = json.loads(out) if out else {}
        except Exception as e: d = {"error": str(e)}
        if "tanks" in d: return d
        if d.get("error") and "permission" not in d["error"].lower(): return d
    return d or {"error": "Could not read the printer."}

def printing():
    try: return "Pro9000II-series-" in subprocess.run(["lpstat","-o"],capture_output=True,text=True,timeout=5).stdout
    except Exception: return False

def gauge_pixbuf(tanks, size=22, worst="ok"):
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, size, size); cr = cairo.Context(surf); s = size/22.0
    cr.set_source_rgba(0,0,0,0.0); cr.paint()
    n = max(1, len(tanks)); bw = (size - 2*s) / n; gap = bw*0.28; top, bot = 2*s, size-3*s
    for i, t in enumerate(tanks or []):
        x = s + i*bw; h = (bot-top) * max(t["level"],0)/100.0
        cr.rectangle(x, top, bw-gap, bot-top); cr.set_source_rgba(0.5,0.5,0.5,0.35); cr.fill()
        if h > 0: cr.rectangle(x, bot-h, bw-gap, h); cr.set_source_rgb(*COLORS.get(t["key"],(0.5,0.5,0.5))); cr.fill()
    if not tanks:
        cr.arc(size/2, size/2, size*0.32, 0, 6.2832); cr.set_source_rgba(0.5,0.5,0.5,0.6); cr.fill()
    if worst in ("low","empty"):
        cr.arc(size-5*s, size-5*s, 4.2*s, 0, 6.2832); cr.set_source_rgb(1,1,1); cr.fill()
        cr.arc(size-5*s, size-5*s, 3.2*s, 0, 6.2832); cr.set_source_rgb(*STATUS_RGB[worst]); cr.fill()
    surf.flush(); return Gdk.pixbuf_get_from_surface(surf, 0, 0, size, size)

class Swatch(Gtk.DrawingArea):
    def __init__(self, rgb):
        super().__init__(); self.rgb = rgb; self.set_size_request(16, 16); self.connect("draw", self.draw)
    def draw(self, w, cr):
        a = w.get_allocation(); cr.arc(a.width/2, a.height/2, 6, 0, 6.2832); cr.set_source_rgb(*self.rgb); cr.fill()
        cr.arc(a.width/2, a.height/2, 6, 0, 6.2832); cr.set_source_rgba(0,0,0,0.22); cr.set_line_width(1); cr.stroke()

class Bar(Gtk.DrawingArea):
    def __init__(self, rgb, level):
        super().__init__(); self.rgb = rgb; self.level = level; self.set_size_request(150, 12); self.connect("draw", self.draw)
    def rr(self, cr, x, y, w, h, r):
        cr.new_sub_path(); cr.arc(x+w-r, y+r, r, -1.5708, 0); cr.arc(x+w-r, y+h-r, r, 0, 1.5708)
        cr.arc(x+r, y+h-r, r, 1.5708, 3.1416); cr.arc(x+r, y+r, r, 3.1416, 4.7124); cr.close_path()
    def draw(self, w, cr):
        a = w.get_allocation(); h = 9; y = (a.height - h) / 2.0
        self.rr(cr, 0, y, a.width, h, h/2); cr.set_source_rgb(0.88,0.88,0.87); cr.fill()
        fw = a.width * max(self.level,0) / 100.0
        if fw > 0: self.rr(cr, 0, y, max(fw, h), h, h/2); cr.set_source_rgb(*self.rgb); cr.fill()

def tooltip_widget(tanks, when, err=None):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin=6); box.get_style_context().add_class("inktip")
    title = Gtk.Label(xalign=0); title.set_markup("<b>Pro9000 Mark II ink</b>" + (f"  <small><span foreground='#6b6b6b'>read {when}</span></small>" if when else "")); box.add(title)
    if not tanks:
        box.add(Gtk.Label(label=err or "No reading yet", xalign=0)); box.show_all(); return box
    g = Gtk.Grid(column_spacing=8, row_spacing=4)
    for r, t in enumerate(tanks):
        rgb = COLORS.get(t["key"], (0.5,0.5,0.5))
        g.attach(Swatch(rgb), 0, r, 1, 1)
        n = Gtk.Label(label=t["name"], xalign=0); n.set_size_request(104, -1); g.attach(n, 1, r, 1, 1)
        c = Gtk.Label(xalign=0); c.set_markup(f"<tt><small>{t['code']}</small></tt>"); c.set_size_request(64, -1); g.attach(c, 2, r, 1, 1)
        g.attach(Bar(rgb, t["level"]), 3, r, 1, 1)
        p = Gtk.Label(xalign=1); p.set_markup(f"<tt>{t['level']:>3}%</tt>"); g.attach(p, 4, r, 1, 1)
        f = Gtk.Label(xalign=0); st = t["status"]
        if st in ("low","empty"):
            col = "#b25a00" if st=="low" else "#b3261e"; f.set_markup(f"<b><span foreground='{col}'>{st.upper()}</span></b>")
        f.set_size_request(48, -1); g.attach(f, 5, r, 1, 1)
    box.add(g); box.show_all(); return box

TOOLTIP_CSS = b"""
tooltip { background-color: #ffffff; border: 1px solid #bdbdbd; border-radius: 6px; color: #1e1e1e; padding: 2px; }
tooltip * { color: #1e1e1e; }
.inktip label { color: #1e1e1e; }
.preview { background-color: #ffffff; }
"""
def install_css():
    prov = Gtk.CssProvider(); prov.load_from_data(TOOLTIP_CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

class Tray:
    def __init__(self):
        install_css(); Notify.init("Pro9000 ink")
        self.icon = Gtk.StatusIcon(); self.icon.set_title("Pro9000 ink levels"); self.icon.set_visible(True)
        self.icon.connect("activate", self.open_viewer); self.icon.connect("popup-menu", self.popup)
        self.icon.set_has_tooltip(True); self.icon.connect("query-tooltip", self.query_tooltip)
        self.tanks = []; self.err = None; self.when = None
        self.prev = self.load_state()
        self.icon.set_from_pixbuf(gauge_pixbuf([]))
        GLib.timeout_add_seconds(5, self.poll)
    def query_tooltip(self, icon, x, y, kb, tip):
        tip.set_custom(tooltip_widget(self.tanks, self.when, self.err)); return True
    def load_state(self):
        try: return json.load(open(STATE))
        except Exception: return {}
    def save_state(self, st):
        try: os.makedirs(os.path.dirname(STATE), exist_ok=True); json.dump(st, open(STATE,"w"))
        except Exception: pass
    def poll(self):
        if printing():
            self.err = "Printer busy - will re-check shortly"; GLib.timeout_add_seconds(RETRY_MIN*60, self.poll); return False
        d = load()
        if "error" in d:
            self.err = d["error"]; self.icon.set_from_pixbuf(gauge_pixbuf([]))
            GLib.timeout_add_seconds(RETRY_MIN*60, self.poll); return False
        self.err = None; self.tanks = d["tanks"]; self.when = d["time"]
        worst = "empty" if any(t["status"]=="empty" for t in self.tanks) else ("low" if any(t["status"]=="low" for t in self.tanks) else "ok")
        self.icon.set_from_pixbuf(gauge_pixbuf(self.tanks, 22, worst))
        self.notify_changes(); GLib.timeout_add_seconds(POLL_MIN*60, self.poll); return False
    def notify_changes(self):
        cur = {t["key"]: t["status"] for t in self.tanks}; first = not self.prev
        for t in self.tanks:
            was = self.prev.get(t["key"]); now = t["status"]
            if now in ("low","empty") and (first or was != now):
                title = f"{t['name']} ink is {'EMPTY' if now=='empty' else 'low'}"
                body = f"{t['code']}  ·  {t['level']}% remaining on the Canon Pro9000 Mark II"
                n = Notify.Notification.new(title, body, "printer"); n.set_urgency(Notify.Urgency.CRITICAL if now=="empty" else Notify.Urgency.NORMAL)
                try: n.show()
                except Exception: pass
        self.prev = cur; self.save_state(cur)
    def popup(self, icon, button, t):
        m = Gtk.Menu()
        if self.tanks:
            for tk in self.tanks:
                it = Gtk.MenuItem(label=f"{tk['name']}  ({tk['code']})   {tk['level']}%" + (f"   {tk['status'].upper()}" if tk['status']!='ok' else "")); it.set_sensitive(False); m.append(it)
            it = Gtk.MenuItem(label=f"Read at {self.when}"); it.set_sensitive(False); m.append(it)
        else:
            it = Gtk.MenuItem(label=self.err or "No reading yet"); it.set_sensitive(False); m.append(it)
        m.append(Gtk.SeparatorMenuItem())
        a = Gtk.MenuItem(label="Open ink viewer"); a.connect("activate", self.open_viewer); m.append(a)
        r = Gtk.MenuItem(label="Refresh now"); r.connect("activate", lambda *_: self.poll()); m.append(r)
        q = Gtk.MenuItem(label="Quit tray icon"); q.connect("activate", Gtk.main_quit); m.append(q)
        m.show_all(); m.popup(None, None, Gtk.StatusIcon.position_menu, icon, button, t)
    def open_viewer(self, *_): subprocess.Popen([GUI])

if __name__ == "__main__":
    if len(sys.argv) > 2 and sys.argv[1] == "--icon-preview":     # render the icon at 88px for checking
        d = load(); tanks = d.get("tanks", [])
        worst = "empty" if any(t["status"]=="empty" for t in tanks) else ("low" if any(t["status"]=="low" for t in tanks) else "ok")
        gauge_pixbuf(tanks, 88, worst).savev(sys.argv[2], "png", [], []); sys.exit(0)
    if len(sys.argv) > 2 and sys.argv[1] == "--tooltip-preview":
        install_css(); d = load(); w = Gtk.OffscreenWindow(); wrap = Gtk.EventBox(); wrap.get_style_context().add_class("preview")
        wrap.add(tooltip_widget(d.get("tanks", []), d.get("time"), d.get("error"))); w.add(wrap); w.show_all()
        def snap():
            pb = w.get_pixbuf(); pb.savev(sys.argv[2], "png", [], []); Gtk.main_quit(); return False
        GLib.timeout_add(800, snap); Gtk.main(); sys.exit(0)
    Tray(); Gtk.main()
